RewriteEngine On

# 1. Do not redirect if the file or directory actually exists (images, css, js)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Redirect everything else to the homepage with a 302 (Temporary)
# This clears the URL bar on reload.
RewriteRule ^(.*)$ http://localhost/ [R=302,L]